# Cloudflare Workers 环境变量配置模板
# 复制此文件为 .dev.vars 或 .env 并填入实际值

# D1 数据库 ID（从 Cloudflare Dashboard 获取）
DATABASE_ID=your-d1-database-id

# JWT 密钥（用于身份验证，建议使用强随机字符串）
JWT_SECRET=your-jwt-secret-here

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password-here

# R2 公共访问 URL（如果有配置自定义域名）
R2_PUBLIC_URL=https://your-r2-public-url

# Giscus 评论系统配置（可选）
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=repo-id
NEXT_PUBLIC_GISCUS_CATEGORY=category-name
NEXT_PUBLIC_GISCUS_CATEGORY_ID=category-id
